{
  "name": "morua-junction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Morua Junction \u2014 Botswana's virtual mall. A Rust marketplace with an offline-first PWA storefront.",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"cargo run --manifest-path rust/Cargo.toml\" \"vite\"",
    "dev:api": "cargo run --manifest-path rust/Cargo.toml",
    "dev:web": "vite",
    "build": "npm run build:web",
    "build:web": "vite build",
    "start": "./rust/target/release/morua",
    "dataset": "tsx scripts/dump-seed.ts",
    "typecheck": "tsc --noEmit",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
